@page "/"
@using ReportAnalizerWASM.Client.Models

<PageTitle>MP Analyzer - Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Color="Color.Primary" GutterBottom="true">Tablero de Control</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="CargarExcel">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.TableView">
                        Cargar Excel Ventas
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            @if (_ventasTodas.Any())
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="LimpiarDatos">
                    Limpiar Datos
                </MudButton>

                <MudDateRangePicker Label="Filtrar Período" DateRange="_rangoFechas" DateRangeChanged="OnRangoCambiado"
                                    Placeholder="Selecciona rango" Color="Color.Primary" Variant="Variant.Outlined" Class="w-25" />

                <MudButton Variant="Variant.Outlined" Color="Color.Success" Disabled="@_exportandoContable" OnClick="DescargarReporteContable">
                    @if (_exportandoContable)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Generando...</MudText>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Download" Class="mr-2" />
                        <MudText>Exportar Contable</MudText>
                    }
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Info" Disabled="@_exportandoRentabilidad" OnClick="DescargarReporteRentabilidad">
                    @if (_exportandoRentabilidad)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Generando...</MudText>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.PieChart" Class="mr-2" />
                        <MudText>Exportar Rentabilidad</MudText>
                    }
                </MudButton>
            }
        </MudStack>

        @if (_cargando)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
            <MudText Typo="Typo.caption">Procesando datos...</MudText>
        }
    </MudPaper>

    @if (_ventasFiltradas.Any())
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4 mud-theme-primary">
                    <MudText>Ventas Brutas</MudText>
                    <MudText Typo="Typo.h5">@_ventasFiltradas.Sum(x => x.MontoBruto).ToString("C")</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4" Style="background-color:#d32f2f; color:white;">
                    <MudText>Comisiones MP</MudText>
                    <MudText Typo="Typo.h5">@_ventasFiltradas.Sum(x => x.MontoComisionMP).ToString("C")</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4" Style="background-color:#d32f2f; color:white;">
                    <MudText>Retenciones (IVA & IIBB)</MudText>
                    <MudText Typo="Typo.h5">@_ventasFiltradas.Sum(x => x.MontoImpuestos).ToString("C")</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-4 mud-theme-success">
                    <MudText>Ganancia Neta</MudText>
                    <MudText Typo="Typo.h5">@_ventasFiltradas.Sum(x => x.MontoNeto).ToString("C")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Class="mt-4 mb-8">

            <MudTabPanel Text="Análisis Gráfico" Icon="@Icons.Material.Filled.Insights">
                <Graficos />
            </MudTabPanel>

            <MudTabPanel Text="Detalle de Operaciones" Icon="@Icons.Material.Filled.TableRows">
                <Grilla />
            </MudTabPanel>

            <MudTabPanel Text="Rentabilidad" Icon="@Icons.Material.Filled.TableRows">
                <Productos />
            </MudTabPanel>

        </MudTabs>
    }
</MudContainer>