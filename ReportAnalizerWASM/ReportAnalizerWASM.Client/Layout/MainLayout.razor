@inherits LayoutComponentBase
@inject Blazored.LocalStorage.ILocalStorageService _localStorage

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Fixed="true" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />

        <MudText Typo="Typo.h6" Class="ml-3">
            MP Analyzer
        </MudText>

        <MudSpacer />

        <MudTooltip Text="@(_isDarkMode ? "Cambiar a Modo Claro" : "Cambiar a Modo Oscuro")">
            <MudIconButton Icon="@(_isDarkMode? Icons.Material.Filled.Brightness7 : Icons.Material.Filled.Brightness4)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
            @Body
    </MudMainContent>

</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true; // Por defecto arrancamos en oscuro
    private const string CLAVE_TEMA = "preferencia_modo_oscuro";

    private MudTheme _theme = new MudTheme()
    {
        // COLORES PARA EL MODO CLARO (Mantenemos los que ya estaban bien)
        PaletteLight = new PaletteLight()
        {
            Primary = "#009EE3",
            Secondary = "#2D3277",
            AppbarBackground = "#009EE3",
            Background = "#F5F6F8",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF", // Barra lateral blanca impecable
            TextPrimary = "#333333"
        },
        // COLORES PARA EL MODO OSCURO (Limpiamos los grises)
        PaletteDark = new PaletteDark()
        {
            Primary = "#009EE3",
            Secondary = "#E0E0E0",
            AppbarBackground = "#111111", // Barra superior casi negra
            Background = "#121212", // Fondo de la página negro clásico (estilo Spotify/Netflix)
            Surface = "#1E1E1E", // Tarjetas en gris oscuro puro, sin tintes raros
            DrawerBackground = "#161616", // <--- EL SECRETO: Barra lateral en gris muy oscuro
            TextPrimary = "#FFFFFF",
            TextSecondary = "#A0A0A0" // Textos secundarios más suaves
        }
    };

    // 1. Al abrir la app, buscamos qué eligió el usuario la última vez
    protected override async Task OnInitializedAsync()
    {
        if (await _localStorage.ContainKeyAsync(CLAVE_TEMA))
        {
            _isDarkMode = await _localStorage.GetItemAsync<bool>(CLAVE_TEMA);
        }
    }

    // 2. Método que cambia el tema y lo guarda al instante
    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await _localStorage.SetItemAsync(CLAVE_TEMA, _isDarkMode);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}